[Unit]
Description=Lightning Labs Aperture L402 Proxy
After=network.target auragrid-api.service auragrid-pricer.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AurAgrid
ExecStart=/home/ubuntu/AurAgrid/scripts/run_aperture.sh
# Bind :443 as the ubuntu user (HTTPS with the Let's Encrypt IP certificate)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aperture

[Install]
WantedBy=multi-user.target
